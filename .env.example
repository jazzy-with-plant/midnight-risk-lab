# Optional. If omitted, viem uses Base's public RPC endpoint.
BASE_RPC_URL=https://mainnet.base.org

# Optional. Defaults to Morpho's public API.
MORPHO_API_URL=https://api.morpho.org

# Optional. Set both values to inspect one exact position.
# If omitted, the CLI discovers a real active Base market with a borrow position.
MARKET_ID=
BORROWER_ADDRESS=
