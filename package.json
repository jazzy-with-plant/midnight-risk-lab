{
  "name": "midnight-risk-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minimal CLI risk monitor for Morpho Midnight fixed-maturity markets",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "node ./node_modules/typescript/lib/tsc.js -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "node ./node_modules/typescript/lib/tsc.js -p tsconfig.json && node dist/index.js",
    "test": "node ./node_modules/typescript/lib/tsc.js -p tsconfig.json && node --test dist/**/*.test.js",
    "check": "node ./node_modules/typescript/lib/tsc.js -p tsconfig.json && node --test dist/**/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@morpho-org/midnight-sdk": "1.6.0",
    "dotenv": "18.0.4",
    "viem": "2.55.10"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "typescript": "7.0.2"
  }
}
